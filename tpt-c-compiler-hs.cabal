cabal-version: 3.0
name: tpt-c-compiler-hs
version: 0.1.0.0
license: MIT
license-file: LICENSE
author: tpt-c-compiler contributors
build-type: Simple
extra-source-files:
  README.md

executable tptcc-hs
  main-is: Main.hs
  hs-source-dirs: src
  other-modules:
    Tptcc.Ast
    Tptcc.CodeGen
    Tptcc.CodeGen.Optimize
    Tptcc.CodeGen.Options
    Tptcc.CodeGen.Render
    Tptcc.CodeGen.Stdlib
    Tptcc.CType
    Tptcc.IRGlobal
    Tptcc.IRSimpleTac
    Tptcc.Lexer
    Tptcc.NodeFields
    Tptcc.Operand
    Tptcc.Parser
    Tptcc.Preprocessor
    Tptcc.SSA
    Tptcc.SymbolTable
    Tptcc.Tac
    Tptcc.Token
    Tptcc.TypeChecker
  build-depends:
    base >=4.16 && <5,
    containers,
    effectful,
    filepath,
    megaparsec,
    optparse-applicative,
    prettyprinter,
    text,
    transformers
  default-extensions:
    DataKinds
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    TypeOperators
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -O2
